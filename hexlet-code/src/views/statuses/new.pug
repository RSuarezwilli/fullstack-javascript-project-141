extends ../layouts/application.pug

block content
  h1.display-4.fw-bold.my-4 Nuevo Estado
  form(action=route('statuses') method='post')
    .mb-3
      label(for='data_name') Nombre
      input#data_name.form-control(name='data[name]' type='text' required)
    input.btn.btn-primary(type='submit' value='Crear')