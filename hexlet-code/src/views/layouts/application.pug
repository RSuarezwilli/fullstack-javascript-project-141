doctype html
html(lang="es")
  head
    title= t('layouts.main.title')
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
  body
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.mb-4
      .container-fluid
        a.navbar-brand(href=route('root'))= t('layouts.main.brand')
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation")
          span.navbar-toggler-icon
        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link(href=route('users'))= t('layouts.main.users')
            li.nav-item
              a.nav-link(href=route('statuses'))= t('layouts.main.statuses')
            li.nav-item
              a.nav-link(href=route('labels'))= t('layouts.main.labels')
            li.nav-item
              a.nav-link(href=route('tasks'))= t('layouts.main.tasks')

    main.container
      each type in ['info', 'error', 'success']
        each message in getMessages(reply)[type] || []
          .alert(class=`alert-${type === 'error' ? 'danger' : type}`) #{message}
      
      block content

    footer.footer.mt-auto.py-3.bg-light
      .container
        span.text-muted= t('layouts.main.footer_text')