doctype html
html(lang="es")
  head
    title Administrador de Tareas
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet")
  body
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.mb-4
      .container-fluid
        a.navbar-brand(href='/') Inicio
        .navbar-nav
          a.nav-link(href='/users') Usuarios
          a.nav-link(href='/users/new') Registro

    main.container
  //- 1. Los mensajes Flash (bien alineados)
  if reply && reply.flash
    each messages, type in reply.flash()
      each message in messages
        div(class=`alert alert-${type === 'error' ? 'danger' : 'success'}`)= message

      block content