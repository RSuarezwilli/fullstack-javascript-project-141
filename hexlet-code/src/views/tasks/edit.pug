extends ../layouts/application.pug

block content
  h1.display-4.fw-bold.mt-4= t('layouts.main.tasks')
  //- RUTA MANUAL
  a.btn.btn-primary.mb-3(href='/tasks/new')= t('views.tasks.index.create')

  .card.shadow-sm.mb-4
    .card-body.p-4.bg-light
      //- RUTA MANUAL
      form(action='/tasks' method='get')
        .row
          .col-12.col-md
            .mb-3
              label(for="query_status")= t('views.tasks.search.status')
              select(id="query_status" name="query[status]" class="form-select")
                option(value="")
                each s in (statuses || [])
                  option(value=s.id, selected=(s.id == (query && query.status)))= s.name
          
          .col-12.col-md
            .mb-3
              label(for="query_executor")= t('views.tasks.search.executor')
              select(id="query_executor" name="query[executor]" class="form-select")
                option(value="")
                each u in (users || [])
                  option(value=u.id, selected=(u.id == (query && query.executor)))= `${u.firstName} ${u.lastName}`
          
          .col-12.col-md
            .mb-3
              label(for="query_label")= t('views.tasks.search.label')
              select(id="query_label" name="query[label]" class="form-select")
                option(value="")
                each l in (labels || [])
                  option(value=l.id, selected=(l.id == (query && query.label)))= l.name

        input(class="btn btn-primary" type="submit" value=t('views.tasks.search.filter'))

  table.table.table-striped
    thead
      tr
        th= t('views.tasks.index.id')
        th= t('views.tasks.index.name')
        th= t('views.tasks.index.status')
        th= t('views.tasks.index.author')
        th= t('views.tasks.index.executor')
        th= t('views.tasks.index.labels')
        th= t('views.tasks.index.createdAt')
        th
    tbody
      if tasks
        each task in tasks
          tr
            td= task.id
            td
              a(href=`/tasks/${task.id}`)= task.name
            td= task.status ? task.status.name : ''
            td= task.creator ? `${task.creator.firstName} ${task.creator.lastName}` : ''
            td= task.executor ? `${task.executor.firstName} ${task.executor.lastName}` : ''
            td
              if task.labels
                each label in task.labels
                  span.badge.bg-secondary.me-1= label.name
            td= formatDate(task.createdAt)
            td
              .d-flex
                //- RUTAS MANUALES PARA EVITAR EL ERROR [object Object]
                a.btn.btn-primary.me-1(href=`/tasks/${task.id}/edit`)= t('views.tasks.index.edit')
                +buttonTo(`/tasks/${task.id}`, 'delete')(class="btn btn-danger" value=t('views.tasks.index.delete'))